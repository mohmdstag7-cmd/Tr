# SQLite — source of truth is local, never commit DBs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Env / secrets — never commit
.env
.env.local
.env.*.local
*.key
*.pem

# Models — allow only committed test fixtures, ignore generated models
models/*.joblib
models/*.pkl
models/*.bin
!models/fixtures/
!models/fixtures/*.joblib

# Supabase / local config overrides
.supabase/
local.yaml
config.local.yaml
